<worksheet>
  <title>Lab 2:  Numerical Approximations</title>

  <exercise workspace="1.5in">
    <statement>
      <p>\begin{tabular}{ll}
\begin{tabular}{c}</p>
      <p><term>Due:  February 12</term></p>
      <p>\end{tabular}</p>
      <p>\begin{tabular}{l}
%
Names: \hrulefill  
\hphantom{Names:} \hrulefill 
