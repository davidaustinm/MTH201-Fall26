<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Working with probability</title>

  <exercise>
    <task workspace="1in">
      <statement>
        <p>Suppose that you perform an experiment with outcomes <m>0\leq x\leq
  10</m> and that your data is described by the probability density
  function
  <m>p(x) = \frac 1{50}x</m>.</p>
        <p>What fraction of the data lies in the interval <m>0\leq x \leq 3</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What fraction of the data lies in the interval <m>3\leq x \leq 10</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Compute the integral <m>\int_0^{10} p(x)~dx</m>.  
  What does this integral
  represent?  Why should we have known its value before doing the
  computation?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>For what value of <m>x</m> does 75% of the data lie below <m>x</m>?  This is
  known as the <em>third quartile</em>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>The median <m>m</m> is the point where half of the data is less than <m>m</m>
  and half is more than <m>m</m>.  What is the median?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>The <em>cumulative distribution</em> function <m>C(s)</m> measures the
  fraction of data in the range <m>0\leq x \leq s</m>.  Find an expression
  for <m>C(s)</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is <m>C'(s)</m>?  Why should we have known this before doing the
  computation?</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <task workspace="1in">
      <statement>
        <p>Suppose that <m>p(x) = K(81x-x^3)</m> is a probability density
  function where <m>0\leq x \leq 9</m> and <m>K</m> is some constant.  What do
  you know about the integral <m>\int_0^9 p(x)~dx</m>? Use that
  observation to determine <m>K</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p>Sketch a graph of <m>p</m>. Near what value of <m>x</m> are outcomes most
  likely?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Find the median <m>m</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p>Find and sketch the cumulative distribution function <m>C(s)</m>.</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <task workspace="1in">
      <statement>
        <p>Suppose that the results of an experiment are described by the
  cumulative distribution function <m>C(s) = \sin(\pi s/10)</m> where the
  outcomes satisfy <m>0\leq x \leq 5</m>.</p>
        <p>What fraction of the data is less than 2?
  What fraction of the data is more than 2?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is the median <m>m</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is the first quartile <m>x</m>, the point where 25% of the data is
  less than <m>x</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What fraction of the data lies between 1 and 2?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What is the probability density function?</p>
      </statement>
    </task>
  </exercise>

</worksheet>
