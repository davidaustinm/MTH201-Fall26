  <exercise>
    <task workspace="0.25in">
      <statement>
        <p>Shown below is the graph of a function <m>f(x)</m>.</p>
        <p><image source="figures/plreview.eps"/></p>
        <p>Evaluate the definite integrals:</p>
        <p><m>\bullet\,\int_0^1 f(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="0.25in">
      <statement>
        <p><m>\bullet\,\int_1^3 f(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="0.25in">
      <statement>
        <p><m>\bullet\,\int_0^3 f(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="0.25in">
      <statement>
        <p><m>\bullet\,\int_0^4 f(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="0.25in">
      <statement>
        <p><m>\bullet\,\int_0^5 f(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="0.25in">
      <statement>
        <p><m>\bullet\,\int_2^5 f(x)~dx</m></p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <task workspace="1in">
      <statement>
        <p>Evaluate the definite integrals using the Fundamental Theorem of
  Calculus:</p>
        <p><m>\bullet\,\int_{-1}^3 (3x^2+x)~dx</m></p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p><m>\bullet\,\int_0^\pi \sin x~dx</m></p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p><m>\bullet\,\int_0^2 e^x~dx</m></p>
      </statement>
    </task>
  </exercise>

</worksheet>
