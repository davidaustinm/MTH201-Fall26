<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Antiderivatives using substitution (Section 5.3)</title>

  <exercise>
    <task workspace="1.25in">
      <statement>
        <p>Find antiderivatives of these functions:</p>
        <p><m>\ds \int\cos(17t)~dt</m></p>
      </statement>
    </task>
    <task workspace="1.25in">
      <statement>
        <p><m>\ds \int x^4\sqrt{1+x^5}~dt</m></p>
      </statement>
    </task>
    <task workspace="1.25in">
      <statement>
        <p><m>\ds \int\sqrt{x-1}~dx</m></p>
      </statement>
    </task>
    <task workspace="1.25in">
      <statement>
        <p><m>\ds\int e^x(1+4e^x)^4~dt </m></p>
      </statement>
    </task>
    <task workspace="1.25in">
      <statement>
        <p><m>\ds \int\frac{\sin(t)}{\cos^2(t)}~dt</m></p>
      </statement>
    </task>
    <task workspace="1.1in">
      <statement>
        <p><m>\ds\int\frac{1}{(x-2)^3}~dx</m></p>
      </statement>
    </task>
    <task workspace="1.1in">
      <statement>
        <p><m>\ds\int xe^{-x^2}~dx</m></p>
      </statement>
    </task>
    <task workspace="1.1in">
      <statement>
        <p><m>\ds\int \frac{e^t-e^{-t}}{e^t+e^{-t}}~dt</m></p>
      </statement>
    </task>
    <task workspace="1.1in">
      <statement>
        <p><m>\ds\int\frac{\cos(\sqrt{x})}{\sqrt{x}}~dx</m></p>
      </statement>
    </task>
    <task workspace="1.1in">
      <statement>
        <p><m>\ds\int 5000\left[1 - \frac{100}{(t+10)^2}\right]~dt</m></p>
      </statement>
    </task>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Evaluate the definite integral
  <m>\ds\int_0^{15}\frac12 \sin\left(\frac{2\pi t}{5}\right)~dt</m></p>
    </statement>
  </exercise>

</worksheet>
