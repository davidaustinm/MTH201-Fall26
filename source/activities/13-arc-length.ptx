<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Some more geometry</title>

  <exercise workspace="1in">
    <statement>
      <p>%</p>
    </statement>
  </exercise>

  <exercise workspace="3.5in">
    <statement>
      <p>Find the arc length along the curve <m>y=\sqrt{4-x^2}</m> between
  %   <m>-2\leq x \leq 2</m>.  You should be able to evaluate this integral
  %   exactly.</p>
      <p>%</p>
    </statement>
  </exercise>

  <exercise>
    <task workspace="3in">
      <statement>
        <p>Consider the curve <m>y=2x^{3/2}</m> and find the arc length
    along this cruve between <m>2\leq x \leq 5</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Suppose that you start at <m>x=0</m> and walk along this curve moving
    to the right for a
    distance of 10 units.  Where do you end up?</p>
      </statement>
    </task>
  </exercise>

  <exercise workspace="2.5in">
    <statement>
      <p>Set up an integral that measures the arc length along the
    curve <m>y = x^2</m> between <m>0\leq x \leq 2</m>.  
    Use your calculator or Desmos to estimate the integral giving the
    arc length.</p>
    </statement>
  </exercise>

  <exercise>
    <task workspace="1.5in">
      <statement>
        <p>Find the following antiderivatives:</p>
        <p><m>\ds\int x^2\sin(x)~dx</m></p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p><m>\ds\int x^2\sin(x^3)~dx</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p><m>\ds\int xe^{2x}~dx</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p><m>\ds\int xe^{x^2}~dx</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p><m>\ds\int 3t\cos(4t)~dt</m>.</p>
      </statement>
    </task>
    <task workspace="1.5in">
      <statement>
        <p><m>\ds\int \frac{1}{\sqrt{4x+1}}~dx</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p><m>\ds\int (z+1)e^{5z}~dz</m>.</p>
      </statement>
    </task>
  </exercise>

</worksheet>
