<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Separable Differential Equations</title>

  <exercise workspace="3in">
    <statement>
      <p>Solve the initial value problem:
  <md>
<mrow>\frac{dy}{dt} \amp = \amp 2y^2</mrow>
<mrow>y(-1) \amp = \amp 2</mrow>
</md></p>
    </statement>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Solve the initial value problem:
  <md>
<mrow>\frac{dy}{dt} \amp = \amp -\frac ty</mrow>
<mrow>y(0) \amp = \amp 5</mrow>
</md></p>
    </statement>
  </exercise>

  <exercise>
    <task workspace="0.8in">
      <statement>
        <p>Suppose that a cup of cofee is initially at a temperature of
  105<m>^\circ</m> F and is placed in a 75<m>^\circ</m> room.  Newton's law of
  cooling says that
  <md>
  \frac{dT}{dt} = -k(T-75),
  </md>
  where <m>k</m> is a constant of proportionality.</p>
        <p>Suppose you know that the coffee is cooling at one degree per
  minute at the time the coffee is brought into the room.  Use this
  fact to determine the value of the constant <m>k</m>.</p>
      </statement>
    </task>
    <task workspace="2in">
      <statement>
        <p>Find all solutions to the differential equation.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What happens to all the solutions as <m>t\to\infty</m>?  Explain how
  this agrees with your intuition.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>Find the solution with <m>T(0) = 105</m>.  
  What is the temperature of the cup of coffee after 20 minutes?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>How long does it take to cool to 80<m>^\circ</m>?</p>
      </statement>
    </task>
  </exercise>

</worksheet>
