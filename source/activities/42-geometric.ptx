<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Geometric Series</title>

  <exercise>
    <task workspace="2in">
      <statement>
        <p>What is the sum of the series
  <md>1+\frac12+\left(\frac12\right)^2+
  \left(\frac12\right)^3+\ldots+\left(\frac12\right)^n</md>
  where <m>n = 3</m>?  <m>n=5</m>? <m>n=7</m>? <m>n=10</m>? <m>n=15</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What happens as <m>n\to\infty</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <task workspace="2in">
      <statement>
        <p>Now look at the sum
  <md>1+2+2^2+2^3+\ldots+2^n</md></p>
        <p>Find the sum when <m>n=5</m>, <m>n=6</m>, <m>n=10</m> and <m>n=15</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What happens as <m>n\to\infty</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <task workspace="2in">
      <statement>
        <p>Find the sum
  <md>1+(-1)+(-1)^2+(-1)^3+\ldots+(-1)^n</md>
  where <m>n = 5</m>?  <m>n=6</m>? <m>n=7</m>? <m>n=8</m>? <m>n=9</m>?</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>What happens as <m>n\to\infty</m>?</p>
      </statement>
    </task>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>Write out the first four terms of the series represented as
  <m>\displaystyle \sum_{n=3}^{9}\frac4{3^n}</m>.  Then determine the value
  of this sum.</p>
    </statement>
  </exercise>

  <exercise>
    <task workspace="1in">
      <statement>
        <p>For what values of <m>r</m> does this limit exist:
<md>
\lim_{n\to\infty} (1+r+r^2+r^3+\ldots+r^n)</md></p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>If the limit exists, what is its value?</p>
      </statement>
    </task>
  </exercise>

</worksheet>
