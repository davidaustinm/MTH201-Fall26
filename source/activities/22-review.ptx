<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Review</title>

  <exercise workspace="2in">
    <statement>
      <p>Suppose that a water tank is formed by rotating the portion of
the graph <m>y=x^2</m> between <m>0\leq x\leq2</m> about the <m>y</m>-axis.  The
units on the axes are meters.</p>
      <p>Find the total volume of the tank.</p>
    </statement>
  </exercise>

  <exercise workspace="2.5in">
    <statement>
      <p>Suppose that the tank is filled to a depth of 3 meters with water
whose density is 1000 kg/m<m>^3</m>.  Find the mass of the water in the
tank.</p>
    </statement>
  </exercise>

  <exercise workspace="2in">
    <statement>
      <p>Find the center of mass of the water.</p>
    </statement>
  </exercise>

  <exercise workspace="2.5in">
    <statement>
      <p>How much work is required to pump all the water to a height of one
meter above the top of the tank?</p>
    </statement>
  </exercise>

  <exercise workspace="2.5in">
    <statement>
      <p>Suppose the pump breaks down after 30,000 Joules of work has been
done.  What is the height of water left in the tank?</p>
    </statement>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Suppose that a more careful analysis shows that the density varies as
<m>\rho(y)=1005-10y</m>.  Find the center of mass now.</p>
    </statement>
  </exercise>

</worksheet>
