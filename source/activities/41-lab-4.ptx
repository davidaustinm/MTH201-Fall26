<worksheet>
  <title>Lab 4:  Systems of differential equations</title>
  <introduction>
    <p>\begin{tabular}{ll}
\begin{tabular}{l}</p>
    <p><term>Due:  April 3</term></p>
    <p>\end{tabular}</p>
    <p>\begin{tabular}{l}
%
Names: \hrulefill  
