<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Area</title>

  <exercise workspace="3in">
    <statement>
      <p>Find the area between the graph <m>y=e^x</m> and the line <m>y=1</m>
  between <m>x=0</m> and <m>x=3</m>.</p>
    </statement>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Find the area bounded by the curve <m>x=y^3-3y</m> and the lines
  <m>x=4</m>, <m>y=-2</m> and <m>y=2</m>.</p>
      <p><image source="figures/14-area.eps"/></p>
    </statement>
  </exercise>

  <exercise workspace="3.5in">
    <statement>
      <p>The graphs of <m>y=x^3-3x</m> and <m>y=2x^2</m> intersect at the points
  <m>x=-1</m>, <m>x=0</m> and <m>x=3</m>.  Find the total area bounded by the
  graphs.</p>
    </statement>
  </exercise>

  <exercise workspace="1in">
    <statement>
      <p>Find the area bounded by the graph <m>y=\frac4{1+x^2}</m> and the
  line <m>y=2</m>.</p>
    </statement>
  </exercise>

</worksheet>
